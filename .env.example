# OpenAI API Key (for image generation and TTS)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google AI API Key (for Nano Banana/Gemini image generation)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Veo3 API Key (for video generation)
VEO_API_KEY=your-veo3-api-key-here

# RFC MCP Server Configuration (optional, defaults shown)
RFC_MCP_SERVER_URL=http://localhost:3000
