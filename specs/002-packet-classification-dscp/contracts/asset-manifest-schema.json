{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isthispacketimportant.game/schemas/asset-manifest.json",
  "title": "Asset Manifest",
  "description": "Schema for asset manifests (images, cutscenes, audio) tracking generation parameters",
  "type": "object",
  "required": ["version", "type", "assets"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "type": {
      "type": "string",
      "enum": ["images", "cutscenes", "audio"],
      "description": "Asset type this manifest tracks"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the manifest was last updated"
    },
    "styleGuide": {
      "type": "string",
      "description": "Path to style guide (for images/cutscenes)"
    },
    "voiceConfig": {
      "type": "string",
      "description": "Path to voice config (for audio)"
    },
    "assets": {
      "type": "object",
      "description": "Map of asset ID to asset details",
      "additionalProperties": { "$ref": "#/$defs/Asset" }
    },
    "totalSize": {
      "type": "integer",
      "description": "Total size of all assets in bytes"
    }
  },
  "$defs": {
    "Asset": {
      "type": "object",
      "required": ["id", "path", "generatedAt", "checksum"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique asset identifier"
        },
        "path": {
          "type": "string",
          "description": "Relative path to the asset file"
        },
        "generator": {
          "type": "string",
          "enum": ["nano-banana", "openai-image", "veo3", "openai-tts"],
          "description": "Which tool generated this asset"
        },
        "prompt": {
          "type": "string",
          "description": "The prompt used to generate the asset"
        },
        "seed": {
          "type": ["integer", "string"],
          "description": "Seed value for reproducibility"
        },
        "model": {
          "type": "string",
          "description": "Model version used (e.g., dall-e-3, veo-3)"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the asset was generated"
        },
        "checksum": {
          "type": "string",
          "description": "SHA-256 hash of the file for golden-file testing"
        },
        "size": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions",
          "description": "For images/videos"
        },
        "duration": {
          "type": "number",
          "description": "Duration in seconds (for video/audio)"
        },
        "voiceId": {
          "type": "string",
          "description": "Voice ID used (for TTS audio)"
        },
        "characterId": {
          "type": "string",
          "description": "Character this asset belongs to"
        },
        "sceneId": {
          "type": "string",
          "description": "Scene this asset belongs to"
        }
      }
    },
    "Dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    }
  }
}
