{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isthispacketimportant.game/schemas/level.json",
  "title": "Level",
  "description": "Schema for game level definition files",
  "type": "object",
  "required": ["id", "name", "scenes", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique level identifier",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "description": "Display name for the level"
    },
    "description": {
      "type": "string",
      "description": "Brief level description"
    },
    "scenes": {
      "type": "array",
      "description": "Ordered array of scenes in the level",
      "items": { "$ref": "#/$defs/Scene" },
      "minItems": 1
    },
    "metadata": { "$ref": "#/$defs/LevelMetadata" }
  },
  "$defs": {
    "Scene": {
      "type": "object",
      "required": ["id", "type", "assets", "next"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique scene identifier within the level"
        },
        "type": {
          "type": "string",
          "enum": ["intro", "decision", "boss", "debrief"],
          "description": "Scene type"
        },
        "traffic": {
          "$ref": "#/$defs/TrafficType",
          "description": "Traffic info (required for decision/boss types)"
        },
        "timer": {
          "$ref": "#/$defs/TimerConfig",
          "description": "Timer settings (required for decision/boss types)"
        },
        "assets": { "$ref": "#/$defs/SceneAssets" },
        "dialog": {
          "type": "string",
          "description": "Path to dialog JSON for this scene"
        },
        "citations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of citation IDs used in this scene"
        },
        "unlockedCategories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "DSCP categories available for this decision"
        },
        "firstUseTerms": {
          "type": "array",
          "items": { "$ref": "#/$defs/TermDefinition" },
          "description": "Terms introduced for the first time"
        },
        "next": { "$ref": "#/$defs/NextScene" }
      }
    },
    "TrafficType": {
      "type": "object",
      "required": ["id", "name", "correctClass", "rfcReference"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "correctClass": {
          "type": "string",
          "description": "Correct DiffServ class (e.g., EF, AF21)"
        },
        "rfcReference": { "$ref": "#/$defs/RFCReference" }
      }
    },
    "TimerConfig": {
      "type": "object",
      "required": ["duration", "type"],
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 30,
          "description": "Timer duration in seconds"
        },
        "type": {
          "type": "string",
          "enum": ["tutorial", "standard", "boss"]
        },
        "warningAt": {
          "type": "number",
          "description": "Seconds remaining to show warning"
        }
      }
    },
    "SceneAssets": {
      "type": "object",
      "properties": {
        "intro": { "type": "string", "description": "Path to intro cutscene video" },
        "success": { "type": "string", "description": "Path to success outcome video" },
        "failure": { "type": "string", "description": "Path to failure outcome video" },
        "background": { "type": "string", "description": "Path to background image" },
        "music": { "type": "string", "description": "Path to background music" }
      }
    },
    "NextScene": {
      "type": "object",
      "required": ["success", "failure"],
      "properties": {
        "success": { "type": "string", "description": "Scene ID on success" },
        "failure": { "type": "string", "description": "Scene ID on failure" },
        "timeout": { "type": "string", "description": "Scene ID on timeout" }
      }
    },
    "TermDefinition": {
      "type": "object",
      "required": ["term", "definition", "citation"],
      "properties": {
        "term": { "type": "string" },
        "definition": { "type": "string" },
        "citation": { "type": "string", "description": "Citation ID" }
      }
    },
    "RFCReference": {
      "type": "object",
      "required": ["rfc", "section"],
      "properties": {
        "rfc": { "type": "number", "description": "RFC number" },
        "section": { "type": "string", "description": "Section identifier" },
        "title": { "type": "string", "description": "Section or RFC title" }
      }
    },
    "LevelMetadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "author": { "type": "string" },
        "version": { "type": "string" },
        "estimatedDuration": { "type": "number", "description": "Minutes" },
        "difficulty": { "type": "string", "enum": ["tutorial", "standard", "advanced"] }
      }
    }
  }
}
