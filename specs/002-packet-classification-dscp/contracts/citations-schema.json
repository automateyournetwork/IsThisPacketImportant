{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isthispacketimportant.game/schemas/citations.json",
  "title": "Citations Manifest",
  "description": "Schema for the RFC citations manifest that tracks all technical claims",
  "type": "object",
  "required": ["version", "citations"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the manifest was last generated"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When citations were last verified against RFCs"
    },
    "citations": {
      "type": "object",
      "description": "Map of citation ID to citation details",
      "additionalProperties": { "$ref": "#/$defs/Citation" }
    }
  },
  "$defs": {
    "Citation": {
      "type": "object",
      "required": ["id", "claimText", "rfc", "section", "excerpt", "verifiedAt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique citation identifier"
        },
        "claimText": {
          "type": "string",
          "description": "The in-game text making the claim"
        },
        "rfc": {
          "type": "integer",
          "description": "RFC number"
        },
        "section": {
          "type": "string",
          "description": "Section identifier (e.g., 4.7, 2.1)"
        },
        "sectionTitle": {
          "type": "string",
          "description": "Title of the cited section"
        },
        "excerpt": {
          "type": "string",
          "description": "Relevant excerpt from the RFC supporting the claim"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When this citation was last verified"
        },
        "verifiedHash": {
          "type": "string",
          "description": "SHA-256 hash of RFC section content at verification"
        },
        "usedIn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Scene IDs where this citation is used"
        }
      }
    }
  }
}
